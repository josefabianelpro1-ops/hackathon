<Window x:Class="SinaloaRiegoInteligente.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sinaloa Inteligente - Monitoreo de Riego" Height="600" Width="980"
        Background="#F4F6F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Lateral -->
        <Border Grid.Column="0" Background="#1E293B" Padding="15">
            <StackPanel>
                <TextBlock Text="SINALOA IOT" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,30"/>

                <Button Content="Dashboard (Ver Todos)" Click="BtnDashboard_Click" Margin="0,5" Padding="10" 
                Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>

                <Button Content="Alertas de Riego" Click="BtnAlertas_Click" Margin="0,5" Padding="10" 
                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>

                <Button Content="Reporte Hídrico" Click="BtnReporte_Click" Margin="0,5" Padding="10" 
                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Monitoreo y Cálculo Hídrico Inteligente" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>

            <!-- Tarjetas de Parcelas -->
            <ListView x:Name="ListaParcelas" Grid.Row="1" ItemsSource="{Binding Parcelas}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="0" Margin="0,5" Width="700">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <!-- Barra lateral de color -->
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Indicador lateral de color según el estado -->
                                <Border Grid.Column="0" Background="{Binding ColorEstado}" CornerRadius="8,0,0,8"/>

                                <StackPanel Grid.Column="1" Margin="15,15,0,15">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                                    <TextBlock Foreground="#64748B" Margin="0,2,0,0">
                                        <Run Text="{Binding Cultivo, StringFormat='Cultivo: {0}'}"/>
                                        <Run Text="{Binding Hectareas, StringFormat=' ({0} ha)'}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HumedadSuelo, StringFormat='Humedad: {0}%'}" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                                    <!-- Texto con color dinámico -->
                                    <TextBlock Text="{Binding EstadoRiego}" Foreground="{Binding ColorEstado}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="Agua Sugerida:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CalcularLitrosAguaNecesarios, StringFormat='{}{0:N0} L'}" FontSize="15" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>

                                <Button Grid.Column="4" Content="Prescripción" Click="BtnActivarRiego_Click" 
                                        Background="#0284C7" Foreground="White" Padding="10,6" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,15,0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>